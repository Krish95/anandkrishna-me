{
  // Cloudflare Pages project config, used by `npm run deploy` (direct upload).
  // If you connect the GitHub repo in the Cloudflare dashboard instead, Pages
  // reads its build settings from there and this file is only used for the
  // project name and output directory.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anandkrishna-me",
  "compatibility_date": "2026-08-14",
  "pages_build_output_dir": "dist"
}
