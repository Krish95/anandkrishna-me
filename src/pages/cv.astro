---
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/Icon.astro';
import { cv } from '@/data/cv';
import { SITE, SOCIALS } from '@/site.config';
import { getPublications } from '@/lib/content';
import { stripMath } from '@/lib/math';

// Only used by the print-only list below: a printed CV that says "see the
// website" for publications is useless to whoever is holding it.
const publications = await getPublications();
---

<PageLayout title="CV" kicker={`${SITE.author.role} · ${SITE.author.affiliation}`} lede={cv.summary}>
  <div class="cv" data-pagefind-body>
    {/* Letterhead for the printed version only — the site header is hidden
        on paper, so the page needs to say whose CV it is. */}
    <header class="print-only">
      <p class="print-name">{SITE.author.name}</p>
      <p class="print-meta">
        {SITE.author.role}, {SITE.author.affiliation} · {SITE.author.location}
      </p>
      <p class="print-meta">
        {SITE.author.email} · {new URL(SITE.url).hostname}
      </p>
      <p class="print-summary">{cv.summary}</p>
    </header>

    <div class="cv__actions">
      {
        cv.resumeUrl && (
          <a class="button" href={cv.resumeUrl} rel="noopener">
            Full CV (PDF)
            <Icon name="arrow-up-right" size={14} />
          </a>
        )
      }
      <a class="button" data-variant="ghost" href={`mailto:${SITE.author.email}`}>
        <Icon name="mail" size={14} />
        Email
      </a>
    </div>

    <!-- Experience -->
    <section class="cv__section">
      <h2 class="cv__heading"><span class="struck">Experience</span></h2>
      <ol class="cv__list">
        {
          cv.experience.map((role) => (
            <li class="row">
              <div class="row__when">
                <p class="meta">
                  {role.start} — {role.end ?? 'Present'}
                </p>
                {role.location && <p class="meta row__where">{role.location}</p>}
              </div>

              <div class="row__what">
                <h3 class="row__title">
                  {role.role}
                  <span class="row__at">at</span>
                  {role.orgUrl ? (
                    <a href={role.orgUrl} class="marker-link" rel="noopener">
                      {role.org}
                    </a>
                  ) : (
                    role.org
                  )}
                </h3>
                {role.summary && <p class="row__summary">{role.summary}</p>}
                {role.highlights && role.highlights.length > 0 && (
                  <ul class="row__highlights">
                    {role.highlights.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Education -->
    <section class="cv__section">
      <h2 class="cv__heading"><span class="struck">Education</span></h2>
      <ol class="cv__list">
        {
          cv.education.map((study) => (
            <li class="row">
              <div class="row__when">
                <p class="meta">{study.start ? `${study.start} — ${study.end}` : study.end}</p>
              </div>
              <div class="row__what">
                <h3 class="row__title">{study.qualification}</h3>
                <p class="row__summary">{study.institution}</p>
                {study.note && <p class="row__note">{study.note}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Publications: a pointer on screen, the full list on paper -->
    <section class="cv__section">
      <h2 class="cv__heading"><span class="struck">Publications</span></h2>

      <p class="pointer screen-only">
        Listed in full on the <a href="/publications" class="marker-link">publications page</a>.
      </p>

      <!--
        Note the explicit `{' '}` after each full stop: Astro 7 compresses
        whitespace with JSX rules, so a newline between text and a tag vanishes
        and the citation would run together as "Tan.Dynamic Regret".
      -->
      <ol class="print-only printpubs">
        {
          publications.map((pub) => (
            <li>
              <span class="printpubs__authors">{pub.data.authors.join(', ')}</span>.{' '}
              <span class="printpubs__title">{stripMath(pub.data.title)}</span>.{' '}
              <span class="printpubs__venue">{pub.data.venue}</span>,{' '}
              {pub.data.date.getUTCFullYear()}.
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Teaching -->
    <section class="cv__section">
      <h2 class="cv__heading"><span class="struck">Teaching</span></h2>
      <ol class="cv__list cv__list--tight">
        {
          cv.teaching.map((course) => (
            <li class="row">
              <div class="row__when">
                <p class="meta">{course.when}</p>
              </div>
              <div class="row__what">
                <h3 class="row__title row__title--sm">
                  {course.title}
                  {course.code && <span class="row__code">{course.code}</span>}
                </h3>
                <p class="meta">
                  {course.institution}
                  {course.role && <span class="row__role"> · {course.role}</span>}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Awards -->
    <section class="cv__section">
      <h2 class="cv__heading"><span class="struck">Awards &amp; honours</span></h2>
      <ol class="cv__list cv__list--tight">
        {
          cv.awards.map((award) => (
            <li class="row">
              <div class="row__when">
                <p class="meta">{award.date}</p>
              </div>
              <div class="row__what">
                <h3 class="row__title row__title--sm">
                  {award.url ? (
                    <a href={award.url} class="marker-link" rel="noopener">
                      {award.title}
                    </a>
                  ) : (
                    award.title
                  )}
                </h3>
                {award.awarder && <p class="meta">{award.awarder}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Service -->
    <section class="cv__section">
      <h2 class="cv__heading"><span class="struck">Academic service</span></h2>
      <p class="label">Subreviewer</p>
      <ul class="chips">
        {cv.service.map((venue) => <li>{venue}</li>)}
      </ul>
    </section>

    <!-- Skills + languages -->
    <section class="cv__section">
      <h2 class="cv__heading"><span class="struck">Areas &amp; tools</span></h2>
      <div class="groups">
        {
          cv.skills.map((group) => (
            <div>
              <p class="label">{group.group}</p>
              <ul class="chips">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
        <div>
          <p class="label">Languages</p>
          <ul class="chips">
            {
              cv.languages.map((language) => (
                <li>
                  {language.name}
                  <span class="chips__level">{language.level}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Elsewhere: screen only, since the letterhead already carries contact -->
    <section class="cv__section screen-only">
      <h2 class="cv__heading"><span class="struck">Elsewhere</span></h2>
      <ul class="elsewhere">
        {
          SOCIALS.filter((s) => s.icon !== 'rss').map(({ label, href, icon }) => (
            <li>
              <a href={href} rel={href.startsWith('http') ? 'me noopener' : undefined}>
                <Icon name={icon} size={16} />
                <span>{label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</PageLayout>

<style>
  .cv {
    max-width: 54rem;
  }

  .cv__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .print-name {
    font-family: var(--font-serif);
    font-size: 16pt;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 0.2rem;
  }

  .print-meta {
    font-family: var(--font-sans);
    font-size: 9pt;
    margin: 0.1rem 0;
    color: #222;
  }

  .printpubs {
    margin: 0;
    padding-left: 1.15rem;
    display: grid;
    gap: 0.4rem;
    font-size: 9.5pt;
    line-height: 1.35;
  }

  .printpubs li::marker {
    color: #444;
  }

  .printpubs__title {
    font-style: italic;
  }

  .printpubs__venue {
    font-weight: 600;
  }

  .print-summary {
    font-size: 9.5pt;
    line-height: 1.4;
    margin: 0.5rem 0 0;
    max-width: 68ch;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.58rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--btn-ink);
    background: var(--btn-bg);
    border: 2px solid var(--btn-border);
    border-radius: var(--radius);
    transition:
      translate 150ms ease,
      box-shadow 150ms ease;
  }

  .button:hover {
    translate: -2px -2px;
    box-shadow: 4px 4px 0 var(--btn-shadow);
  }

  .button[data-variant='ghost'] {
    background: transparent;
    color: var(--ink-soft);
    border-color: var(--rule-strong);
  }

  .button[data-variant='ghost']:hover {
    box-shadow: 4px 4px 0 var(--btn-shadow);
  }

  .cv__section {
    padding-block: 3rem;
    border-top: 1px solid var(--rule);
  }

  .cv__section:first-of-type {
    border-top: 0;
    padding-top: 2.5rem;
  }

  .cv__heading {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    margin: 0 0 2rem -0.42em;
  }

  .cv__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }

  .cv__list--tight {
    gap: 1.5rem;
  }

  .row {
    display: grid;
    gap: 0.5rem 2.5rem;
  }

  @media (width >= 44rem) {
    .row {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  .row__when p {
    margin: 0;
    white-space: nowrap;
  }

  .row__where {
    color: var(--ink-faint);
    margin-top: 0.2rem !important;
  }

  .row__title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 0.4rem;
    text-wrap: pretty;
  }

  .row__title--sm {
    font-size: 1.02rem;
    margin-bottom: 0.25rem;
  }

  .row__at {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-inline: 0.35em;
  }

  .row__summary {
    margin: 0;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .row__note {
    margin: 0.4rem 0 0;
    font-size: 0.92rem;
    color: var(--ink-faint);
    font-style: italic;
    text-wrap: pretty;
  }

  .row__role {
    color: var(--ink-faint);
  }

  .row__code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--ink-faint);
    margin-left: 0.5em;
  }

  .row__highlights {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .row__highlights li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .row__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.42em;
    height: 0.42em;
    background: var(--accent-mark);
    rotate: 45deg;
  }

  .pointer {
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink-soft);
  }

  .groups {
    display: grid;
    gap: 1.75rem;
  }

  @media (width >= 44rem) {
    .groups {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    }
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
  }

  .chips li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.34em 0.55em;
    color: var(--ink-soft);
    background: var(--paper-sunken);
    border: 1px solid var(--rule);
    border-radius: 2px;
  }

  .chips__level {
    margin-left: 0.45em;
    color: var(--ink-faint);
  }

  .chips__level::before {
    content: '· ';
  }

  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .elsewhere a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .elsewhere a:hover {
    color: var(--ink);
  }
</style>
