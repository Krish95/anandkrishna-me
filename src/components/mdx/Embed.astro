---
/**
 * Responsive iframe wrapper for video/demo embeds.
 *
 * ```mdx
 * <Embed src="https://www.youtube-nocookie.com/embed/VIDEO_ID" title="Demo walkthrough" />
 * ```
 *
 * Lazy-loaded, and the aspect box prevents the layout shift a bare iframe causes.
 */
interface Props {
  src: string;
  /** Required for screen readers — describe what the embed shows. */
  title: string;
  /** CSS aspect-ratio value, e.g. "16 / 9" or "1 / 1". */
  ratio?: string;
  allow?: string;
}

const {
  src,
  title,
  ratio = '16 / 9',
  allow = 'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen',
} = Astro.props;
---

<div class="embed" style={`--ratio: ${ratio}`}>
  <iframe src={src} title={title} allow={allow} loading="lazy" referrerpolicy="no-referrer"></iframe>
</div>

<style>
  .embed {
    margin-block: 2em;
    aspect-ratio: var(--ratio);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-sunken);
  }

  .embed iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
