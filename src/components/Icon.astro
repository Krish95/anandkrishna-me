---
/**
 * Inline SVG icon set. Inlined rather than fetched from an icon font/CDN so
 * there's no extra request and no CSP exception.
 *
 * All paths are drawn on a 24x24 grid and stroke-based, so they inherit
 * `currentColor` and look right at any size.
 */
export type IconName =
  | 'mail'
  | 'github'
  | 'x'
  | 'linkedin'
  | 'rss'
  | 'scholar'
  | 'dblp'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'sun'
  | 'moon'
  | 'monitor'
  | 'search'
  | 'link'
  | 'file-text'
  | 'video'
  | 'quote';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;

// Brand marks are solid fills; UI glyphs are strokes.
const FILLED: IconName[] = ['github', 'x', 'linkedin'];
const isFilled = FILLED.includes(name);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFilled ? 'currentColor' : 'none'}
  stroke={isFilled ? 'none' : 'currentColor'}
  stroke-width={isFilled ? undefined : 1.6}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {
    name === 'mail' && (
      <>
        <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
        <path d="M3 6.5l9 6 9-6" />
      </>
    )
  }
  {
    name === 'github' && (
      <path d="M12 1.5a10.5 10.5 0 00-3.32 20.47c.52.1.71-.23.71-.5v-1.75c-2.9.63-3.52-1.4-3.52-1.4-.47-1.2-1.16-1.52-1.16-1.52-.95-.65.07-.64.07-.64 1.05.08 1.6 1.08 1.6 1.08.93 1.6 2.44 1.14 3.03.87.1-.68.37-1.14.66-1.4-2.32-.27-4.76-1.16-4.76-5.16 0-1.14.4-2.07 1.07-2.8-.11-.26-.47-1.32.1-2.75 0 0 .87-.28 2.85 1.07a9.9 9.9 0 015.2 0c1.97-1.35 2.84-1.07 2.84-1.07.57 1.43.21 2.49.1 2.75.67.73 1.07 1.66 1.07 2.8 0 4.01-2.45 4.89-4.78 5.15.38.33.72.97.72 1.96v2.9c0 .28.19.61.72.5A10.5 10.5 0 0012 1.5z" />
      )
  }
  {
    name === 'x' && (
      <path d="M17.53 3h3.02l-6.6 7.54L21.75 21h-5.9l-4.62-6.04L5.9 21H2.88l6.86-7.84L2.4 3h6.05l4.29 5.67L17.53 3zm-1.06 16.2h1.67L7.6 4.72H5.81L16.47 19.2z" />
    )
  }
  {
    name === 'linkedin' && (
      <path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3V9zm6.5 0h3.83v1.64h.05a4.2 4.2 0 013.78-2.08c4.04 0 4.79 2.66 4.79 6.12V21h-4v-5.35c0-1.28-.02-2.92-1.78-2.92-1.78 0-2.05 1.39-2.05 2.83V21h-4V9z" />
    )
  }
  {
    name === 'rss' && (
      <>
        <path d="M4 11a9 9 0 019 9" />
        <path d="M4 4a16 16 0 0116 16" />
        <circle cx="5" cy="19" r="1.4" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'arrow-right' && (
      <>
        <path d="M4 12h15" />
        <path d="M13 6l6 6-6 6" />
      </>
    )
  }
  {
    name === 'arrow-up-right' && (
      <>
        <path d="M7 17L17 7" />
        <path d="M8 7h9v9" />
      </>
    )
  }
  {
    name === 'sun' && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
      </>
    )
  }
  {name === 'moon' && <path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z" />}
  {
    name === 'monitor' && (
      <>
        <rect x="2.5" y="4" width="19" height="13" rx="2" />
        <path d="M8 20.5h8M12 17.5v3" />
      </>
    )
  }
  {
    name === 'search' && (
      <>
        <circle cx="11" cy="11" r="6.5" />
        <path d="M16 16l4.5 4.5" />
      </>
    )
  }
  {
    name === 'link' && (
      <>
        <path d="M9.5 13.5a3.5 3.5 0 005 0l3-3a3.54 3.54 0 00-5-5l-1 1" />
        <path d="M14.5 10.5a3.5 3.5 0 00-5 0l-3 3a3.54 3.54 0 005 5l1-1" />
      </>
    )
  }
  {
    /* Mortarboard, for Google Scholar. */
    name === 'scholar' && (
      <>
        <path d="M2.5 8.5L12 4l9.5 4.5L12 13 2.5 8.5z" />
        <path d="M6 10.6V16c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5v-5.4" />
      </>
    )
  }
  {
    /* Stacked records, for DBLP's bibliography listing. */
    name === 'dblp' && (
      <>
        <path d="M4 6.5h16M4 12h16M4 17.5h10" />
      </>
    )
  }
  {
    name === 'file-text' && (
      <>
        <path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8l-5-5z" />
        <path d="M14 3v5h5M9 13h6M9 17h4" />
      </>
    )
  }
  {
    name === 'video' && (
      <>
        <rect x="2.5" y="6" width="14" height="12" rx="2" />
        <path d="M16.5 10.5l5-3v9l-5-3z" />
      </>
    )
  }
  {
    name === 'quote' && (
      <>
        <path d="M9 7.5C6.8 8.6 5.5 10.6 5.5 13v3.5h4V12H7.2c.2-1.4 1-2.4 2.4-3.1L9 7.5z" />
        <path d="M18 7.5c-2.2 1.1-3.5 3.1-3.5 5.5v3.5h4V12h-2.3c.2-1.4 1-2.4 2.4-3.1L18 7.5z" />
      </>
    )
  }
</svg>
