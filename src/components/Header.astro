---
import { NAV, SITE } from '@/site.config';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

/** `/blog` should stay lit while you're reading `/blog/some-post`. */
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a href="/" class="wordmark" aria-label={`${SITE.title} — home`}>
      {SITE.title}
    </a>

    <nav aria-label="Primary">
      <ul class="nav">
        {
          NAV.map(({ label, href }) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="/search" class="icon-button" aria-label="Search the site">
        <Icon name="search" size={16} />
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-bottom: 1px solid var(--rule);
    backdrop-filter: blur(8px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    /* Sits hard left; nav takes the remaining space. */
    margin-right: auto;
  }

  .wordmark:hover {
    background: var(--marker);
    box-shadow: 0 0 0 3px var(--marker);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    padding-block: 0.35rem;
    transition: color 150ms ease;
  }

  .nav a:hover {
    color: var(--ink);
  }

  .nav a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -0.35em 0 var(--marker-wash);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .icon-button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
    color: var(--ink-soft);
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .icon-button:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  /* On narrow screens the wordmark keeps its own row and nav sits below,
     which reads better than squeezing everything onto one line. */
  @media (width < 34rem) {
    .site-header__inner {
      flex-wrap: wrap;
      padding-block: 0.6rem;
      gap: 0.5rem 1rem;
    }

    .wordmark {
      margin-right: auto;
    }

    nav {
      order: 3;
      width: 100%;
    }

    .nav {
      gap: 0.9rem;
      overflow-x: auto;
      /* Let the row bleed to the container edges when it scrolls. */
      padding-bottom: 0.15rem;
      scrollbar-width: none;
    }

    .nav::-webkit-scrollbar {
      display: none;
    }
  }
</style>
