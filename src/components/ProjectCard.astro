---
import { Image } from 'astro:assets';
import type { Project } from '@/lib/content';
import Icon from './Icon.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, description, year, role, stack, status, cover, coverAlt, url } = project.data;
const href = `/projects/${project.id}`;
---

<article class="project">
  {
    cover && (
      <a href={href} class="project__media" tabindex="-1" aria-hidden="true">
        <Image src={cover} alt={coverAlt ?? ''} width={640} height={400} loading="lazy" />
      </a>
    )
  }

  <div class="project__body">
    <div class="project__head">
      <h3 class="project__title">
        <a href={href} class="marker-link">{title}</a>
      </h3>
      <span class="project__status" data-status={status}>{status}</span>
    </div>

    <p class="meta project__meta">
      <span>{year}</span>
      {
        role && (
          <>
            <span aria-hidden="true">·</span>
            <span>{role}</span>
          </>
        )
      }
    </p>

    <p class="project__desc">{description}</p>

    {
      stack.length > 0 && (
        <ul class="project__stack">
          {stack.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }

    {
      url && (
        <a class="project__link" href={url} rel="noopener">
          Visit
          <Icon name="arrow-up-right" size={13} />
        </a>
      )
    }
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
    padding: 1.15rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition:
      border-color 180ms ease,
      translate 180ms ease;
  }

  .project:hover {
    border-color: var(--rule-strong);
    translate: 0 -2px;
  }

  .project__media {
    display: block;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 2px;
    /* Negative margin so the image sits flush inside the card padding. */
    margin: -0.35rem -0.35rem 0;
  }

  .project__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
  }

  .project__body {
    display: flex;
    flex-direction: column;
    /* Push the Visit link to the bottom so cards in a row align. */
    flex: 1;
  }

  .project__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project__title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .project__status {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25em 0.5em;
    border-radius: 2px;
    white-space: nowrap;
    color: #16232a;
  }

  .project__status[data-status='shipped'] {
    background: var(--mint);
  }

  .project__status[data-status='building'] {
    background: var(--marker);
  }

  .project__status[data-status='experiment'] {
    background: var(--sky);
  }

  .project__status[data-status='archived'] {
    background: var(--paper-sunken);
    color: var(--ink-faint);
    border: 1px solid var(--rule);
  }

  .project__meta {
    margin: 0.35rem 0 0;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .project__desc {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    text-wrap: pretty;
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
  }

  .project__stack li {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink-faint);
    padding: 0.25em 0.45em;
    border: 1px solid var(--rule);
    border-radius: 2px;
  }

  .project__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.9rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    align-self: flex-start;
  }

  .project__link:hover {
    color: var(--ink);
  }
</style>
